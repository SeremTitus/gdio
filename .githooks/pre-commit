#!/usr/bin/env bash
#
# pre-commit — keep the Rust code rustfmt- and clippy-clean.
#
# Runs only when Rust sources (or Cargo manifest/lock) are staged, so
# non-Rust commits stay instant. Fast checks only — `cargo audit` and tests
# are intentionally NOT here. Bypass with:
#   git commit --no-verify
#
# Enabled via `git config core.hooksPath .githooks` (scripts/setup-hooks.sh does this).

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

say()  { printf '\033[1;36m▶ %s\033[0m\n' "$*"; }
fail() { printf '\033[1;31m✗ %s\033[0m\n' "$*" >&2; exit 1; }

# Skip entirely unless the commit touches Rust files.
if ! git diff --cached --name-only --diff-filter=ACM \
     | grep -qE '\.rs$|^Cargo\.(toml|lock)$'; then
  exit 0
fi

say "pre-commit: rustfmt"
cargo fmt --check \
  || fail "Unformatted code. Run:  cargo fmt"

say "pre-commit: clippy"
cargo clippy --all-targets -- -D warnings \
  || fail "Clippy found issues. Fix them, or bypass this once with:  git commit --no-verify"

say "pre-commit: OK"
